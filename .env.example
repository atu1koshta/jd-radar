# --- LLM ----------------------------------------------------------------
LLM_BACKEND=ollama
LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
LLM_NUM_CTX=16384
LLM_BASE_URL=http://localhost:11434
# Bump if your machine takes a while to load the model on the first call.
LLM_REQUEST_TIMEOUT_S=600
# LLM_MAX_TOKENS=

# --- Embeddings ---------------------------------------------------------
EMBED_BACKEND=noop

# --- Resume (single source of truth on GitHub) -------------------------
RESUME_LOADER=github_yaml
RESUME_URL=https://raw.githubusercontent.com/atu1koshta/developer-journey/main/resume.yaml
RESUME_CACHE_PATH=data/resume_cache.yaml
RESUME_REFRESH_TTL_MIN=60
# Optional. Set if the repo becomes private later.
# GITHUB_TOKEN=

# --- Portals ------------------------------------------------------------
ENABLED_PORTALS=naukri
ENABLED_ACTIONS=alert,draft_email

# --- Default search filters --------------------------------------------
# Canonical, portal-agnostic. Each adapter maps these to its own URL grammar
# (Naukri: jobAge=, experience=, ctcFilter=). Override per-run with the
# `--posted-within`, `--experience`, `--ctc` flags on `jobhunter run`.
# Naukri's ctcFilter is band-snapped; the adapter floors `DEFAULT_EXPECTED_CTC_LPA`
# onto the nearest band start (0, 3, 6, 10, 15, 25, 50, 75, 100).
# DEFAULT_POSTED_WITHIN_DAYS=1
# DEFAULT_EXPERIENCE_YEARS=6
# DEFAULT_EXPECTED_CTC_LPA=25

# --- Naukri credentials -------------------------------------------------
NAUKRI_EMAIL=
NAUKRI_PASSWORD=
NAUKRI_BASE_URL=https://www.naukri.com

# --- Browser ------------------------------------------------------------
BROWSER_HEADLESS=true
BROWSER_STORAGE_STATE_DIR=data/storage_state
BROWSER_HUMAN_DELAY_MS_MIN=250
BROWSER_HUMAN_DELAY_MS_MAX=900

# --- OTP via IMAP (deferred — only needed for portals using email OTP) -
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
# Use a Gmail App Password, not your main account password.

# --- Telegram -----------------------------------------------------------
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- SMTP (used only after manual approval) ----------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Storage ------------------------------------------------------------
DATABASE_URL=sqlite:///data/jobhunter.db

# --- Behavior -----------------------------------------------------------
RISK_TOLERANCE=0.3
DRY_RUN=true
LOG_LEVEL=INFO
