*.pyc
*.pyo
*.pyd
*$py.class
*.egg-info/
*.egg
.eggs/
.python-version

# --- Virtual envs -------------------------------------------------------
.venv/
venv/
env/
ENV/
.virtualenv/

# --- Secrets / local config (never commit) -----------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# --- Build / packaging --------------------------------------------------
dist/
build/
*.whl
*.tar.gz
pip-wheel-metadata/

