.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
nosetests.xml
*.cover

# --- Local runtime state (never commit) --------------------------------
data/jobhunter.db
data/jobhunter.db-*
data/jobhunter.db.*
data/resume_cache.yaml
data/storage_state/
data/chroma/
data/snapshots/
data/runs/

# Browser automation artefacts (Phase 2)
.playwright/
playwright-report/
test-results/

# Logs
*.log
logs/

# --- IDE / OS -----------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# --- Project-specific ---------------------------------------------------
